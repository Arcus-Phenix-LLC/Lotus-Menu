{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lotus Menu",
  "version": "0.2.0",
  "identifier": "com.arcusphenix.lotusmenu",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Lotus Menu", "width": 820, "height": 560, "minWidth": 580, "minHeight": 400 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": [] }
}
